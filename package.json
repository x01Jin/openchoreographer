{
  "name": "openchoreographer",
  "version": "1.4.2",
  "description": "A lightweight OpenCode V2 orchestrator plugin with worker and reviewer subagents that outputs quality without eating too much usage",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x01Jin/openchoreographer.git"
  },
  "author": "x01Jin (https://github.com/x01Jin)",
  "homepage": "https://github.com/x01Jin/openchoreographer#readme",
  "bugs": {
    "url": "https://github.com/x01Jin/openchoreographer/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./src/tui/tui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "agents",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/fallback.test.ts tests/shared.test.ts tests/diff.test.ts tests/settings.test.ts tests/agents.test.ts tests/clip.test.ts",
    "build:tui": "node --import tsx scripts/build-tui.ts",
    "check:tui": "node --import tsx scripts/build-tui.ts --check",
    "prepublishOnly": "npm run build:tui && npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.2"
  },
  "peerDependencies": {
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.2",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "26.6.5",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "orchestrator",
    "subagents",
    "tui",
    "review"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
