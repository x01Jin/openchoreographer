{
  "name": "openchoreographer",
  "version": "0.1.0",
  "description": "Read-only orchestrator, worker and reviewer agents, and a collapsible agent/model sidebar for OpenCode V2.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x01Jin/openchoreographer.git"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "shared.ts",
    "agents",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "openchoreographer": "./bin/install.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dry-run": "node bin/install.mjs --dry-run",
    "smoke:install": "node bin/install.mjs --project --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@opencode/client": "2.1.3",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "solid-js": "1.9.12"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "orchestrator",
    "subagents",
    "tui",
    "review"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
