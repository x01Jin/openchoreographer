{
  "name": "openchoreographer",
  "version": "1.2.0",
  "description": "Read-only orchestrator, worker and reviewer agents, and a collapsible agent/model sidebar for OpenCode V2.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x01Jin/openchoreographer.git"
  },
  "author": "x01Jin (https://github.com/x01Jin)",
  "homepage": "https://github.com/x01Jin/openchoreographer#readme",
  "bugs": {
    "url": "https://github.com/x01Jin/openchoreographer/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "shared.ts",
    "fallback.ts",
    "rpc.ts",
    "settings.ts",
    "agents",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "openchoreographer": "bin/install.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/fallback.test.ts tests/shared.test.ts tests/diff.test.ts tests/settings.test.ts tests/installer.test.ts tests/agents.test.ts",
    "prepublishOnly": "npm run typecheck",
    "dry-run": "node bin/install.mjs --dry-run",
    "smoke:install": "node bin/install.mjs --project --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.1.3",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "26.6.5",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "orchestrator",
    "subagents",
    "tui",
    "review"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
