{
  "name": "openchoreographer",
  "version": "1.4.0",
  "description": "A lightweight OpenCode V2 orchestrator plugin with worker and reviewer subagents that outputs quality without eating too much usage",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x01Jin/openchoreographer.git"
  },
  "author": "x01Jin (https://github.com/x01Jin)",
  "homepage": "https://github.com/x01Jin/openchoreographer#readme",
  "bugs": {
    "url": "https://github.com/x01Jin/openchoreographer/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "agents",
    "docs",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "openchoreographer": "bin/install.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/fallback.test.ts tests/shared.test.ts tests/diff.test.ts tests/settings.test.ts tests/installer.test.ts tests/agents.test.ts tests/clip.test.ts",
    "prepublishOnly": "npm run typecheck",
    "dry-run": "node bin/install.mjs --dry-run",
    "smoke:install": "node bin/install.mjs --project --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.2"
  },
  "peerDependencies": {
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.2",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "26.6.5",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "orchestrator",
    "subagents",
    "tui",
    "review"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
